{
  "name": "beer-from-scratch",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Steampunk / neo-brutalist single-page app for a home beer recipe brewed from scratch",
  "scripts": {
    "dev": "bun ./index.html",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && bun build ./index.html --outdir dist --minify --public-path /beer-from-scratch/ --define process.env.NODE_ENV='\"production\"'"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/bun": "^1.1.14",
    "typescript": "^5.6.3"
  }
}
